# Copie este arquivo para ".env" e preencha os valores.
# O arquivo .env NUNCA deve ser enviado ao Git (ele já está no .gitignore).

# --- Acesso ao site -------------------------------------------------------
# Usuário e senha pedidos pelo navegador ao abrir o site.
# Deixe APP_PASSWORD vazio para desativar o login (só faça isso em testes).
APP_USER=soc
APP_PASSWORD=troque-esta-senha

# --- Identidade visual dos relatórios -------------------------------------
COMPANY_NAME=Minha Empresa SOC
# Opcional: arquivo de logo dentro de app/static (ex.: logo.png)
COMPANY_LOGO=

# --- Have I Been Pwned ----------------------------------------------------
# Opcional. Sem chave, o site usa apenas os recursos gratuitos do HIBP
# (lista pública de incidentes). Com a chave do plano já contratado, também
# consulta os domínios verificados no painel e os e-mails monitorados.
HIBP_API_KEY=
HIBP_USER_AGENT=DeepWebMonitor-SOC

# --- Fontes ---------------------------------------------------------------
# Domínios parecidos (dnstwist) fazem milhares de consultas DNS e podem levar
# alguns minutos por domínio. Use "false" para desativar.
DNSTWIST_ENABLED=true

# --- Avançado -------------------------------------------------------------
DATABASE_URL=sqlite:///data/deepwebmonitor.db
HTTP_TIMEOUT=30
