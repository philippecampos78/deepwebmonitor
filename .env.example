# Copie este arquivo para ".env" e preencha os valores.
# O arquivo .env NUNCA deve ser enviado ao Git (ele já está no .gitignore).

# --- Acesso ao site -------------------------------------------------------
# Usuário e senha pedidos pelo navegador ao abrir o site.
# Deixe APP_PASSWORD vazio para desativar o login (só faça isso em testes).
APP_USER=soc
APP_PASSWORD=troque-esta-senha

# --- Identidade visual dos relatórios -------------------------------------
COMPANY_NAME=UXGUARD
# Logo: caminho dentro de app/static (ex.: img/logo-uxguard.png) ou caminho completo
# (ex.: C:\Imagens\logo.png). Vazio = logo da UXGUARD. Use uma versão em preto:
# o site a deixa branca automaticamente sobre o fundo escuro.
COMPANY_LOGO=img/logo-uxguard.png
# Rodapé dos relatórios
COMPANY_FOOTER=UXGUARD LTDA · CNPJ 57.270.568/0001-40
COMPANY_ADDRESS=Rua dos Guajajaras, 1570 · Sala 502 · Belo Horizonte/MG · CEP 30.180-099

# --- Have I Been Pwned ----------------------------------------------------
# Opcional. Sem chave, o site usa apenas os recursos gratuitos do HIBP
# (lista pública de incidentes). Com a chave do plano já contratado, também
# consulta os domínios verificados no painel e os e-mails monitorados.
HIBP_API_KEY=
# Identificação enviada a todas as fontes (o HIBP exige uma).
HIBP_USER_AGENT=DeepWebMonitor-SOC

# --- Fontes ---------------------------------------------------------------
# Domínios parecidos (dnstwist) fazem milhares de consultas DNS e podem levar
# alguns minutos por domínio. Use "false" para desativar.
DNSTWIST_ENABLED=true

# GitHub: busca de código público mencionando o domínio do cliente.
# Crie um token gratuito em https://github.com/settings/personal-access-tokens
# (fine-grained, "Public repositories (read-only)", sem nenhuma permissão extra).
GITHUB_TOKEN=
# gitleaks classifica os segredos encontrados. Sem ele, usamos regras internas
# mais simples. Windows: caminho completo do gitleaks.exe (ex.: C:\Ferramentas\gitleaks.exe)
GITLEAKS_PATH=gitleaks

# AlienVault OTX: funciona sem chave, mas com chave gratuita o limite é maior.
# Crie em https://otx.alienvault.com (Settings > API Key).
OTX_API_KEY=

# abuse.ch (URLhaus e ThreatFox): exige chave gratuita.
# Crie em https://auth.abuse.ch/ (login com conta GitHub, Google ou LinkedIn).
ABUSECH_AUTH_KEY=

# VirusTotal: reputação do domínio em ~90 antivírus. Chave gratuita (4 consultas/min,
# 500/dia) em https://www.virustotal.com > Sign up > menu do perfil > API key.
VIRUSTOTAL_API_KEY=

# urlscan.io: páginas falsas usando a marca do cliente. Funciona sem chave, mas a
# chave gratuita (https://urlscan.io/user/signup > Settings & API) libera a busca
# completa pelo nome da marca e limites maiores.
URLSCAN_API_KEY=
URLSCAN_DAYS=90

# Consultas DNS (SPF/DKIM/DMARC e IPs dos servidores):
#   doh   = DNS via HTTPS (Cloudflare), funciona atrás de proxy corporativo (padrão)
#   local = DNS configurado no computador
DNS_MODE=doh
DNS_DOH_URL=https://cloudflare-dns.com/dns-query

# Quantos dias para trás olhar no RansomLook e nos certificados do crt.sh.
RANSOMLOOK_DAYS=90
CRTSH_DAYS=90

# --- Avançado -------------------------------------------------------------
DATABASE_URL=sqlite:///data/deepwebmonitor.db
HTTP_TIMEOUT=30
